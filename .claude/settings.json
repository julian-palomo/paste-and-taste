{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(git stash *)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git add . *)",
      "Bash(git commit --amend *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin main *)",
      "Bash(git reset --hard *)",
      "Bash(git clean -f *)",
      "Bash(git rebase *)",
      "Bash(git config user.name *)",
      "Bash(git config user.email *)",
      "Bash(git config --global *)",
      "Bash(gh pr merge *)",
      "Bash(gh secret *)",
      "Bash(gh repo delete *)",
      "Bash(env)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./.dev.vars)",
      "Read(./.dev.vars.*)"
    ],
    "ask": [
      "Bash(pnpm add *)",
      "Bash(pnpm install *)",
      "Bash(npx wrangler *)",
      "Bash(pnpm exec wrangler *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git shortlog *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "Bash(git fetch *)",
      "Bash(git switch -c *)",
      "Bash(git worktree *)",
      "Bash(git add *)",
      "Bash(git commit -m *)",
      "Bash(git commit -F *)",
      "Bash(git push -u origin *)",
      "Bash(git push)",
      "Bash(git merge origin/main)",
      "Bash(pnpm verify)",
      "Bash(pnpm check)",
      "Bash(pnpm test *)",
      "Bash(pnpm knip *)",
      "Bash(pnpm exec biome *)",
      "Bash(pnpm exec turbo run *)",
      "Bash(pnpm -C * build)",
      "Bash(pnpm -C * typecheck)",
      "Bash(pnpm -C * test)",
      "Bash(pnpm view *)",
      "Bash(npm view *)",
      "Bash(mkdir -p .plan-review)",
      "Bash(cp * .plan-review/plan.md)",
      "Edit(/.plan-review/**)",
      "Bash(gh api 'repos/{owner}/{repo}/issues/*' --jq .author_association)",
      "Bash(gh api 'repos/{owner}/{repo}/pulls/*/comments' --jq *)",
      "WebFetch(domain:registry.npmjs.org)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr comment *)",
      "Bash(gh run view *)",
      "Bash(bash .claude/hooks/tests/run.sh)",
      "Bash(bash .claude/skills/implement-issue/wait-for-reply.sh *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-invariants.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
