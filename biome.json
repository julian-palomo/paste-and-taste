{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!pnpm-lock.yaml",
      "!apps/api/worker-configuration.d.ts",
      "!apps/api/openapi.json",
      "!apps/web/worker-configuration.d.ts",
      "!apps/web/src/routeTree.gen.ts",
      "!packages/api-client/src/schema.d.ts",
      "!prototypes/login/drizzle/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}
