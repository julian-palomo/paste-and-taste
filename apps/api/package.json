{
  "name": "@paste-and-taste/api",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist --env=\"\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "wrangler dev",
    "smoke": "node scripts/smoke.ts",
    "openapi": "node scripts/openapi.ts",
    "openapi:check": "node scripts/openapi.ts --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "types": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "catalog:",
    "@better-auth/passkey": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cfworker/json-schema": "catalog:",
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-socket": "catalog:",
    "@paste-and-taste/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
