// No account ID, token or secret here: whoever deploys supplies them.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paste-and-taste-api",
  // Wrangler bundles the TypeScript entry itself.
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-15",
  // Deliberately no nodejs_compat: nothing in the Worker uses a Node API.
  // A dependency that needs one adds the flag in its own change.
  "vars": {
    "APP_ENV": "development"
  },
  // An environment doesn't inherit vars: each one sets every variable again.
  "env": {
    "preview": {
      "vars": {
        "APP_ENV": "preview"
      }
    },
    "production": {
      "vars": {
        "APP_ENV": "production"
      }
    }
  }
}
