// No account ID, token or secret here: whoever deploys supplies them.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paste-and-taste-web",
  // Our own entry, not "@tanstack/react-start/server-entry": with the
  // package's entry as main, src/server.ts never runs and the request context
  // it builds is empty.
  "main": "src/server.ts",
  "compatibility_date": "2026-11-15",
  // The TanStack Start and Cloudflare guides' setup has it.
  "compatibility_flags": ["nodejs_compat"],
  // The top level is local development (`pnpm -C apps/web dev`): the API at
  // `pnpm -C apps/api dev`'s address, over HTTP.
  "vars": {
    "API_URL": "http://localhost:8787",
    "INDEXING": "allowed"
  },
  // An environment is chosen at build time, with CLOUDFLARE_ENV, and doesn't
  // inherit vars or services: each one sets every value again. Deployed, the
  // API is reached through a Service binding to that environment's API Worker,
  // never through its public address. Keep INDEXING in step with
  // NOINDEX_ENVIRONMENTS in scripts/check-web.ts.
  "env": {
    "preview": {
      "vars": {
        "INDEXING": "blocked"
      },
      "services": [{ "binding": "API", "service": "paste-and-taste-api-preview" }]
    },
    "production": {
      // Blocked until the app has a domain of its own: see
      // docs/adr/2026-11-23-how-the-web-app-deploys.md.
      "vars": {
        "INDEXING": "blocked"
      },
      "services": [{ "binding": "API", "service": "paste-and-taste-api-production" }]
    }
  }
}
