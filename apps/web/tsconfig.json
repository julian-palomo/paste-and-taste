{
  "extends": "@paste-and-taste/tsconfig/base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "erasableSyntaxOnly": true
  },
  "include": [
    "src",
    "test",
    "scripts",
    "vite.config.ts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}
